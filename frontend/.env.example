# Used only by the Vite development/preview server.
PAPERBOX_API_TARGET=http://127.0.0.1:8077
# Optional local credential. Set only in the ignored .env.local, never VITE_*.
# Used for loopback, same-origin requests without an explicit credential.
# Explicit browser authentication mode disables this fallback after refresh.
# Remote clients and the Nginx deployment still supply their own API key.
PAPERBOX_API_KEY=
