server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 200m;

    resolver ${PAPERBOX_DNS_RESOLVER} valid=10s ipv6=off;
    set $paperbox_api "${PAPERBOX_API_UPSTREAM}";

    location /api/ {
        proxy_pass $paperbox_api$request_uri;
        proxy_read_timeout ${PAPERBOX_PROXY_TIMEOUT};
        proxy_send_timeout ${PAPERBOX_PROXY_TIMEOUT};
        proxy_request_buffering off;
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /health {
        proxy_pass $paperbox_api$request_uri;
        proxy_read_timeout ${PAPERBOX_PROXY_TIMEOUT};
    }

    # PDF.js uses an ES module worker; older MIME tables do not include .mjs.
    location ~ ^/assets/.*\.mjs$ {
        default_type application/javascript;
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /pdfjs/ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}