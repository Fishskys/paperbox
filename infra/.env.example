# ── 容器侧配置 ────────────────────────────────────────────────────────────────
# docker compose **只读 compose 文件同目录的 .env**，也就是本文件（不是仓库根那份）。
# 用法：cp infra/.env.example infra/.env 然后按环境填写；真实值不要提交（已在 .gitignore）。
# 仓库根 .env 是**应用进程**读的配置，对容器无效。

# 必填：数据库 / 对象存储凭据（换成强口令）
POSTGRES_PASSWORD=change-me-postgres
MINIO_ROOT_USER=paperbox
MINIO_ROOT_PASSWORD=change-me-minio

# 数据持久化目录：默认落在 compose 旁的 ./data/<service>。
# 服务器上建议写绝对路径（迁移机器时只改这里，数据随之搬家）：
# POSTGRES_DATA_DIR=/srv/paperbox/data/postgres
# OPENSEARCH_DATA_DIR=/srv/paperbox/data/opensearch
# OPENSEARCH_BACKUP_DIR=/srv/paperbox/data/opensearch-backups   # 快照仓库落点（compose 挂到 /mnt/backups + -Epath.repo）
# MINIO_DATA_DIR=/srv/paperbox/data/minio
# EMBEDDING_MODELS_DIR=/srv/paperbox/data/embedding-models

# 依赖端口绑定地址：默认 0.0.0.0（全部网卡）。只让本机应用访问依赖时设 127.0.0.1，
# 对外只留应用端口（8077，或经反代走 443）。
# PAPERBOX_BIND_IP=127.0.0.1

# ── 模型与资源 ────────────────────────────────────────────────────────────────
# 下排是本机（9GB WSL）实测的安全值；服务器按物理内存放大。
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# 精排模型：多语言档 jinaai/jina-reranker-v2-base-multilingual（1.1GB，需 RERANK_MAX_BATCH=4）；
# 轻量英文档 Xenova/ms-marco-MiniLM-L-6-v2（0.08GB，RERANK_MAX_BATCH 可回 16）。
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
# 单次精排的候选上限：交叉编码器激活内存随 (token × 候选数) 增长
# （实测 4→2.4GB / 8→3.3GB / 16→5.1GB，3GB 封顶会被 OOM-kill）。
RERANK_MAX_BATCH=4
ORT_THREADS=4
# /embed 单次上限：必须与仓库根 .env 的 EMBEDDING_BATCH_SIZE 一致（超批返回 422）。
MAX_BATCH=16

# OpenSearch 初始管理员口令：安全插件当前禁用（plugins.security.disabled=true），
# 该值不参与校验；若将来启用安全插件，务必在这里设强口令。
# OPENSEARCH_ADMIN_PASSWORD=change-me-too

# ── docling 解析服务（2026-09-28 起为本地自建镜像，见 infra/docling/Dockerfile）──────
# 数据目录（挂 /var/lib/docling，只放 docling 的缓存，模型在镜像里）
# DOCLING_DATA_DIR=/srv/paperbox/data/docling
# 容器内存上限：宁可 docling 被 OOM-kill（app 侧降级 pypdf），也别拖垮同机的 embedding
# DOCLING_MEM_LIMIT=3000m
# DOCLING_CPUS=4
# 仅构建期使用：下载公式模型需要出网，本机走宿主代理（compose 里 build.network: host）
# 服务器若可直连 HuggingFace 就留空
# BUILD_HTTP_PROXY=http://127.0.0.1:7890
# BUILD_HTTPS_PROXY=http://127.0.0.1:7890
