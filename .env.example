# paperbox 配置模板 —— 复制成 .env 后填入真实值。
# paperbox configuration template -- copy to .env and fill in real values.
# 真实的 .env 绝不入库（含凭据，已在 .gitignore 里）。
# NEVER commit the real .env (it holds credentials and is gitignored).

# PostgreSQL（论文元数据的事实源）
# PostgreSQL (fact source for paper metadata)
# 注意：主机名一律写 127.0.0.1，不要写 localhost —— 本机 WSL2 镜像模式不转发 IPv6 回环，
# 而 Windows 的 localhost 优先解析到 ::1，会先撞约 8 秒超时才退回 IPv4。
# Note: always write 127.0.0.1, never localhost -- WSL2 mirrored networking does not
# forward the IPv6 loopback, and Windows resolves localhost to ::1 first, so every
# connection eats an ~8s timeout before falling back to IPv4.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=paperbox
# 完整 SQLAlchemy DSN，优先级最高 —— 会覆盖上面的 POSTGRES_* 分项。
# Full SQLAlchemy DSN, authoritative -- overrides the POSTGRES_* parts above.
POSTGRES_DSN=postgresql+psycopg://postgres:change-me-postgres@127.0.0.1:5432/paperbox

# OpenSearch（全文 + 向量索引）
# OpenSearch (full-text + vector index)
OPENSEARCH_URL=http://127.0.0.1:9200
OPENSEARCH_INDEX=paper_chunks_v3
OPENSEARCH_ALIAS=paper_chunks_current

# MinIO（PDF 对象存储）
# MinIO (object storage for PDFs)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=paperbox
MINIO_SECRET_KEY=change-me-minio
MINIO_SECURE=false
MINIO_BUCKET=paperbox

# Embedding 服务（外部服务；模型必须与 OpenSearch 索引的向量空间一致）
# Embedding Server (external service; model must match the OpenSearch index space)
EMBEDDING_URL=http://127.0.0.1:8090
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# multilingual-e5-large：1024 维、输入上限 512 token —— 所以切块控制在 ~450 token 以内。
# 应用启动时会做三方维度对账（容器模型实测输出 ↔ 本键 ↔ 活索引 knn_vector），不符拒绝启动；
# 换 embedding 模型后必须整库重嵌（runbook：docs/architecture/04-embedding.md §9）。
# multilingual-e5-large: 1024 dims, 512 token input limit -> keep chunks <= ~450 tokens.
# Startup checks this key against the model's measured width and the live index mapping;
# switching models always requires re-embedding the whole library.
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
# 单批 HTTP 超时（秒）。embedding 容器把推理串在一条 FIFO 队列后面（T7.3），
# 请求可能要排在别人后面，所以这个值必须大于最坏排队时间，否则排队会变成失败。
# Per-batch HTTP timeout (seconds). The embedding container serialises inference
# behind one FIFO queue (T7.3), so a request may wait behind others: this value must
# exceed the worst-case queueing time or queueing turns into failures.
EMBEDDING_TIMEOUT=300
EMBEDDING_MAX_RETRIES=2

# 仅用于启动日志标注环境名（local/prod/...）；不影响任何行为。
# Only labels the environment in startup logs (local/prod/...); changes no behaviour.
APP_ENV=local

# API
# 鉴权总开关，全开全关：同时管 /api/* 与 /mcp（plan:
# 2026-10-05_145619-api-auth-keys-roles）。false（默认）= 所有调用者都是匿名 admin；
# true = 两个面都要求 api_keys 里的 Bearer 密钥（scripts/manage_keys.py）或下面的
# env 引导密钥。true 会拒绝 'change-me' 默认值，且一把密钥都没有时拒绝启动。
# Master auth switch, all-on/all-off: governs /api/* AND /mcp (plan:
# 2026-10-05_145619-api-auth-keys-roles). false (default) = every caller is an
# anonymous admin; true = both surfaces require a bearer key from api_keys
# (scripts/manage_keys.py) or the env bootstrap keys below. true refuses the
# 'change-me' default and refuses to start when no key exists at all.
AUTH_ENABLED=false
# 引导用 admin 密钥（role=admin，agent 名 "default"）。AUTH_ENABLED=true 时绝不能用字面值
# 'change-me'；它同时是签名下载的回落密钥。
# Bootstrap admin key (role=admin, agent name "default"). Never the literal
# 'change-me' with AUTH_ENABLED=true; it is also the download-signing fallback.
PAPER_API_KEY=change-me
PAPER_API_HOST=0.0.0.0
PAPER_API_PORT=8077
LOG_LEVEL=INFO

# 精排（交叉编码器，由 embedding 容器提供）
# Rerank (cross-encoder, served by the embedding container)
RERANK_ENABLED=true
# 精排模型（换模型不用改代码，但见下面 RERANK_MODEL_FILE）：
#   · int8 量化多语言档 temsa/mmarco-mMiniLMv2-L12-H384-v1-onnx-cpu-qint8（0.4GB，最省最快：
#     824 MiB / 0.064 s 每候选 @50 候选） —— 本机现用；中文定标集质量略低于 jina
#   · 多语言档 jinaai/jina-reranker-v2-base-multilingual（1.1GB，1742 MiB / 0.276 s 每候选）
#     —— 内存/CPU 宽裕且中文质量优先的机器选它
#   · 轻量英文档 Xenova/ms-marco-MiniLM-L-6-v2（0.08GB，0.09 s 每候选，RERANK_MAX_BATCH 可回 16）
# Reranker model (switching needs no code change, but see RERANK_MODEL_FILE below):
#   - int8 multilingual tier temsa/mmarco-mMiniLMv2-L12-H384-v1-onnx-cpu-qint8 (0.4GB,
#     cheapest and fastest: 824 MiB / 0.064 s per candidate at 50 candidates) -- used
#     on this machine; slightly below jina on the Chinese calibration set
#   - multilingual tier jinaai/jina-reranker-v2-base-multilingual (1.1GB,
#     1742 MiB / 0.276 s per candidate) -- pick it when RAM/CPU are plentiful and
#     Chinese quality matters most
#   - light English tier Xenova/ms-marco-MiniLM-L-6-v2 (0.08GB, 0.09 s per candidate;
#     RERANK_MAX_BATCH can go back to 16)
RERANK_MODEL=temsa/mmarco-mMiniLMv2-L12-H384-v1-onnx-cpu-qint8
# 只在 RERANK_MODEL 不在 fastembed 内置清单里时才用得上（内置只有 6 个：ms-marco 两个、
# bge-reranker-base、jina tiny/turbo/v2）；指出该模型仓库内的 ONNX 文件。多数 HF 导出是
# onnx/model.onnx，**量化导出常放在仓库根** —— 上面那个 int8 档就是 model.onnx。
# 换回内置档（jina / ms-marco）时把它注释掉即可（内置模型不读这个键）。
# ⚠️ 同样是容器侧键（infra/.env），应用进程不读（2026-10-05 审查更正）。
# Only needed when RERANK_MODEL is not in fastembed's built-in list (built-ins are just
# six: two ms-marco, bge-reranker-base, jina tiny/turbo/v2); it points at the ONNX file
# inside that model repo. Most HF exports use onnx/model.onnx, and **quantised exports
# often sit at the repo root** -- the int8 tier above is model.onnx. Comment it out when
# switching back to a built-in tier (built-ins never read this key).
# WARNING: this is a container-side key too (infra/.env); the app process never reads
# it (corrected by the 2026-10-05 review).
RERANK_MODEL_FILE=model.onnx
# ⚠️ 容器侧键（infra/.env）——**应用进程不读这一行**；放在这里只为换档时参考
# （2026-10-05 审查：曾误记为"应用侧同名键，两处都要改"）。激活内存随
# (token × 候选数) 增长：多语言档/int8 档设 4、轻量 ms-marco 档可回 16。
# int8 档实测批 4/8/16 = 3.2/4.0/4.8 秒每调用（批内按最长补齐，大批更慢也更占内存）
# WARNING: a container-side key (infra/.env) -- the app process does **not** read this
# line; it is here only as a reference when switching tiers (the 2026-10-05 review
# found it had been mislabelled "same key on the app side, change both"). Activation
# memory grows with (tokens x candidates): set 4 for the multilingual/int8 tiers, 16 is
# fine for the light ms-marco tier. The int8 tier measures 3.2/4.0/4.8 s per call at
# batch 4/8/16 (padded to the longest item, so bigger batches are slower and heavier).
RERANK_MAX_BATCH=4
RERANK_URL=http://127.0.0.1:8090
# 精排请求超时（秒）。多语言档 jina ≈0.4-0.47 s/候选（文档截断 2000 字符），
# 候选数 = top_k × RERANK_CANDIDATES（默认 5）：top_k=10 就是 50 条 ≈20s。
# 保持 10 会让精排静默降级（响应 rerank.model=null、rerank_score=null）。
# 轻量 ms-marco 档 0.09 s/doc，10 秒够用；用多语言档请改成 60（覆盖 top_k ≤ 28）。
# Rerank request timeout (seconds). The multilingual jina tier is ~0.4-0.47 s per
# candidate (documents truncated to 2000 chars), and candidates = top_k x
# RERANK_CANDIDATES (default 5): top_k=10 means 50 items, ~20s. Leaving it at 10 makes
# rerank silently degrade (response rerank.model=null, rerank_score=null). The light
# ms-marco tier is 0.09 s/doc, so 10 is enough; with a multilingual tier use 60
# (covers top_k <= 28).
RERANK_TIMEOUT=10
# RERANK_TIMEOUT=60
RERANK_CANDIDATES=5

# 混合检索后端（plan §7 / M5）。"native" = 一个 hybrid 请求交给 paperbox-rrf60 检索管道
# 融合并按论文聚合；"python" = 词/向量两路在进程内融合（A/B 基线，保留为回落）。
# 只影响 mode=hybrid，单次请求可用 "backend" 字段覆盖（AGENTS.md §3.15）。
# Hybrid backend (plan section 7 / M5). "native" = one hybrid request fused by the
# paperbox-rrf60 search pipeline and collapsed to papers; "python" = two legs fused
# in-process (A/B baseline, kept as the fallback). Only mode=hybrid is affected, and
# a single request may override it with the "backend" field (AGENTS.md section 3.15).
SEARCH_BACKEND=native

# ── MCP Agent 接口 / MCP agent interface（docs/architecture/11-mcp-agent-interface.md）──
# 默认关闭：打开它同时必须显式给 Host 白名单，因此升级永远不会弄坏启动。
# Off by default: turning it on also requires an explicit Host allowlist, so an
# upgrade can never break startup.
MCP_ENABLED=false
# MCP_ENABLED=true 时必填，且故意要求显式书写：MCP SDK 的默认行为只接受 127.0.0.1/localhost，
# 对其它 Host 回裸文本 421（客户端侧看不到原因）。把 agent 会用到的地址都列上 —— LAN IP
# **和**主机名，每个都写成 "host" 与 "host:*" 两形。
# 本机示例：127.0.0.1,127.0.0.1:*,localhost,localhost:*,10.181.116.220,10.181.116.220:*,DESKTOP-B0OMMHD:*
# REQUIRED when MCP_ENABLED=true, and required to be explicit on purpose: the MCP
# SDK's default accepts 127.0.0.1/localhost only and answers every other Host with a
# bare-text 421 (invisible from the client side). List every address agents use --
# the LAN IP **and** the hostname, each as "host" and "host:*".
# Example for this machine: 127.0.0.1,127.0.0.1:*,localhost,localhost:*,10.181.116.220,10.181.116.220:*,DESKTOP-B0OMMHD:*
MCP_ALLOWED_HOSTS=
# 写工具在总开关打开前是不可见的（tools/list 里没有）；下面三个单工具开关还要再过它一道。
# Writing tools are invisible until the master switch is on; the three per-tool
# switches below are additionally gated by it.
MCP_WRITE_ENABLED=false
MCP_ALLOW_DELETE=false
MCP_ALLOW_METADATA_WRITE=false
MCP_ALLOW_REINDEX=false
# 每个工具结果的正文预算，以及调用方可以要求的封顶值（超过即 INVALID_ARGUMENT，
# 绝不静默截断）。
# Body-text budget per tool result, and the ceiling a caller may ask for (asking
# above it is INVALID_ARGUMENT, never a silent clamp).
MCP_MAX_CHARS=8000
MCP_MAX_CHARS_CEILING=32000
# 写工具等作业完成多久后改回传作业 id；要小于客户端的单工具超时（Hermes 默认 120s，
# 可调到 300）。
# How long a writing tool waits for its job before handing back a job id; keep it
# below the client's per-tool timeout (Hermes default 120s, raise it to 300).
MCP_WAIT_SECONDS=120
# paper_get_file 发出的签名下载链接（对象存储本身始终私有）。
# Signed download links handed out by paper_get_file (object storage stays private).
MCP_DOWNLOAD_TTL_SECONDS=300
# 这些链接的签名密钥。留空则回落到 PAPER_API_KEY；轮换任一个都会让尚未过期的链接失效
# （它们本来就是短命的）。
# Signing key for those links. Leave empty to fall back to PAPER_API_KEY; rotating
# either invalidates links that are still outstanding (they are meant to be short).
# MCP_DOWNLOAD_SECRET=
# 只有发不出 Host 的客户端（stdio shell）才需要：下载 URL 正常是用 agent 实际访问到的地址拼的。
# 示例：
# Only needed by clients that cannot send a Host (a stdio shell): the download URL
# is normally built from the address the agent actually reached. Example:
# MCP_PUBLIC_BASE_URL=http://10.181.116.220:8077
# 工具契约版本；目前冻结在 v1。
# Tool contract version; frozen at v1 for now.
MCP_TOOLSET=v1
# 更多引导 admin 密钥：name:key 对，用 ";" 分隔。每个 name 即审计里的 agent 名；留空则
# 回落到上面的 PAPER_API_KEY（记作 "default"）。密钥存在 api_keys 表里：
# scripts/manage_keys.py 可按 agent 建密钥，带角色档（read < write < admin）和可读前缀，
# 日志行里带的就是这个前缀。
# 示例：PAPER_API_KEYS=hermes:<key>;codex:<key>;claude-code:<key>
# More bootstrap admin keys: name:key pairs, ";" separated. Each name becomes the
# audit agent name; empty falls back to PAPER_API_KEY above ("default"). Keys live
# in the api_keys table: scripts/manage_keys.py creates per-agent keys with a
# role tier (read < write < admin) and a readable prefix that log lines carry.
# Example: PAPER_API_KEYS=hermes:<key>;codex:<key>;claude-code:<key>
PAPER_API_KEYS=

# RRF 融合权重（SPEC-P1 §H2；1.0 = 等权，0 = 关掉该路）
# RRF fusion weights (SPEC-P1 section H2; 1.0 = equal weight, 0 disables a leg)
RRF_KEYWORD_WEIGHT=1.0
RRF_SEMANTIC_WEIGHT=1.0

# 查询改写（SPEC-P1 §I1）—— 默认关闭；开启时 URL/MODEL/API_KEY 三者都必须给，否则拒绝启动。
# Query rewrite (SPEC-P1 section I1) - OFF by default; when enabled all
# three of URL/MODEL/API_KEY are required or the app refuses to start.
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_URL=
QUERY_REWRITE_API_KEY=
QUERY_REWRITE_MODEL=
QUERY_REWRITE_TIMEOUT=10
QUERY_REWRITE_MAX_CHARS=300
# 单次改写调用的 token 预算。512 给推理模型留了余地（deepseek-flash 之类会在出答案前
# 先花 token 做隐藏推理）；设成 64 会得到空答案 + finish_reason=length。
# Token budget for one rewrite call. 512 keeps room for reasoning models
# (deepseek-flash & co. spend tokens on hidden reasoning before the answer);
# a 64-token cap yields an empty answer + finish_reason=length.
QUERY_REWRITE_MAX_TOKENS=512
QUERY_REWRITE_TARGET_LANGUAGE=en
# 示例（密钥只留在 .env 里）：
# Example (leave the key in .env only):
# QUERY_REWRITE_ENABLED=true
# QUERY_REWRITE_URL=https://api.example.com/v1
# QUERY_REWRITE_MODEL=some-chat-model

# 检索日志（SPEC-P1 §B）
# Search logging (SPEC-P1 section B)
SEARCH_LOG_ENABLED=true
SEARCH_LOG_RESULTS_LIMIT=20

# 导入
# Ingestion
INGEST_DOWNLOAD_TIMEOUT=120
INGEST_MAX_FILE_MB=100
# 同时运行的导入流水线数（进程内队列的并发上限，默认 2）。
# 多出来的上传停在 stage=QUEUED 排队；embedding 是瓶颈，本机不要调大（见 README §3.2）。
# Import pipelines running at once (in-process queue concurrency cap, default 2).
# Extra uploads wait at stage=QUEUED; embedding is the bottleneck, so do not raise it
# locally (see README section 3.2).
INGEST_CONCURRENCY=2

# ── 批量上传：准入 / 限流 / 目录导入 / 压缩包 / 清理（README §3.3）────────────
# ── Batch upload: admission / throttling / directory import / archives / cleanup (README §3.3) ──
# 在途 /ingest/files 请求上限；超出返回 429 + Retry-After（客户端按此退避重试）
# Cap on in-flight /ingest/files requests; over it returns 429 + Retry-After (clients
# back off accordingly).
INGEST_UPLOAD_CONCURRENCY=2
# 处理队列深度阈值：达到后拒**多文件**请求（429）；单文件请求豁免。0 = 关闭该限制
# Queue-depth threshold: once reached, **multi-file** requests are refused (429);
# single-file requests are exempt. 0 = disable this limit.
INGEST_QUEUE_HIGH_WATERMARK=50
# 单请求文件数上限（超出 422）
# Per-request file count cap (over it: 422).
INGEST_MAX_FILES_PER_REQUEST=20
# 单请求总字节上限（超出 413，此时尚未写 staging）
# Per-request total byte cap (over it: 413, before anything reaches staging).
INGEST_MAX_REQUEST_MB=200
# 目录导入白名单根，`;` 或 `,` 分隔；**留空 = /api/papers/ingest/dir 关闭（404）**。
# 只在 PDF 与 app 同机/同挂载卷时使用；root 会 realpath 归一化后必须落在这里面。
# 例：INGEST_LOCAL_ROOTS=D:/papers;C:/Users/me/Documents/arxiv
# Allowlisted roots for directory import, `;` or `,` separated; **empty = the
# /api/papers/ingest/dir endpoint is off (404)**. Only useful when the PDFs sit on
# the same machine/volume as the app; the root is realpath-normalised and must land
# inside this list.
# Example: INGEST_LOCAL_ROOTS=D:/papers;C:/Users/me/Documents/arxiv
INGEST_LOCAL_ROOTS=
# SSRF 闸（app/services/net_guard.py）的逃逸阀：允许 paper_import / /ingest 访问
# 私网地址的白名单（主机名或 CIDR，逗号分隔）。**留空 = 只允许公网**；主机名条目
# 整体信任（不校验其解析地址），CIDR 条目只放行命中网段的地址。
# 例：INGEST_ALLOW_PRIVATE_HOSTS=192.168.31.0/24,nas.local
# Escape hatch for the SSRF guard (app/services/net_guard.py): an allowlist of
# private addresses paper_import / /ingest may reach (hostnames or CIDRs, comma
# separated). **Empty = public addresses only**; a hostname entry is trusted as a
# whole (its resolved addresses are not checked), a CIDR entry only lets through
# addresses inside that range.
# Example: INGEST_ALLOW_PRIVATE_HOSTS=192.168.31.0/24,nas.local
INGEST_ALLOW_PRIVATE_HOSTS=
# 压缩包（仅 zip）上限：本体大小 / 解包条目数 / 解压总量 / 压缩比（三重 zip bomb 防护）
# Archive (zip only) caps: file size / entry count / total uncompressed bytes /
# compression ratio (three layers of zip-bomb defence).
INGEST_ARCHIVE_MAX_MB=500
INGEST_ARCHIVE_MAX_FILES=2000
INGEST_ARCHIVE_MAX_UNCOMPRESSED_MB=5000
INGEST_ARCHIVE_MAX_RATIO=100
# 临时解包目录（留空 = 系统 temp）；TTL 之后由 housekeeping 清理
# Temporary extraction directory (empty = system temp); housekeeping clears it after
# the TTL.
INGEST_ARCHIVE_TMP_DIR=
INGEST_ARCHIVE_TTL_HOURS=24
# staging 残留 / 过期解包目录的清理间隔（秒）；启动时必跑一次
# Cleanup interval for staging leftovers / expired extraction directories (seconds);
# one run always happens at startup.
INGEST_GC_INTERVAL_S=300

# ══════════════════════════════════════════════════════════════════════
# 解析后端（docling；plan .hermes/plans/2026-09-28_160551-docling-parser-backend.md）
# Parser backend (docling; plan .hermes/plans/2026-09-28_160551-docling-parser-backend.md)
# ══════════════════════════════════════════════════════════════════════
# pypdf | docling。默认 docling（2026-09-29 切换，流水线已接线）；docling 不可达时自动降级到
# pypdf 并把原因写进降级账本。改这一个键即可整体回滚。
# pypdf | docling. docling is the default (switched on 2026-09-29, pipeline wired up);
# when docling is unreachable it degrades to pypdf automatically and records the
# reason in the degradation ledger. Flipping this one key rolls the whole thing back.
PARSER_BACKEND=docling
# 并发解析数：docling 是 CPU 密集、容器有配额，保持 1（两个同时跑只会互相拖慢）。
# Concurrent parses: docling is CPU-bound and the container is quota-limited, so keep
# it at 1 (two at once only slow each other down).
PARSER_CONCURRENCY=1
# 解析产物是否缓存到 MinIO（papers/<id>/extracted/parsed/：markdown + docling JSON
# + parse-meta.json）。命中即重放，不再调后端；降级解析会写产物但绝不被重放；
# 部分解析（page_range / PARSER_MAX_PAGES>0）既不读也不写。
# Whether parse artefacts are cached in MinIO (papers/<id>/extracted/parsed/: markdown
# + docling JSON + parse-meta.json). A hit is replayed without calling the backend;
# degraded parses are written but never replayed; partial parses (page_range /
# PARSER_MAX_PAGES>0) neither read nor write the cache.
PARSER_CACHE=true
# 0 = 整篇；>0 只解析前 N 页。只作用于 docling（pypdf 那档便宜，不做截断），截断会写进
# degraded_reason（片段 `pages=1-N`，账本 code `pagination_truncated`），并且**该次解析不进缓存**
# （半篇冒充整篇比慢一点更糟）。
# 0 = the whole document; >0 parses only the first N pages. docling only (pypdf is cheap
# enough not to truncate); a truncation is written into degraded_reason (fragment
# `pages=1-N`, ledger code `pagination_truncated`) and **that parse does not enter the
# cache** (half a document pretending to be whole is worse than being slower).
PARSER_MAX_PAGES=0

# ══════════════════════════════════════════════════════════════════════
# 分块（plan §2 T7.2 —— 语义分块方案 B）
# Chunking (plan section 2 T7.2 -- semantic chunking scheme B)
# ══════════════════════════════════════════════════════════════════════
# length | semantic。length（默认）按 token 预算切；semantic 用检索模型给句子打
# 相似度、在低谷处切块（保留章节边界/页 span/重叠 48/硬顶 450/512 上限），
# 需要 embedding 服务在解析阶段可用；某节嵌入失败 → 该节退回 length 并记 WARNING。
# 换默认值前先跑 scripts/probe_chunk_semantic.py 做 A/B。
# length | semantic. length (default) cuts on a token budget; semantic scores sentence
# similarity with the retrieval model and cuts at the valleys (keeping section
# boundaries / page spans / overlap 48 / hard cap 450 / 512 limit) and needs the
# embedding service available at parse time; if embedding a section fails, that section
# falls back to length and logs a WARNING. Run scripts/probe_chunk_semantic.py for an
# A/B before changing the default.
CHUNK_MODE=length
# 语义模式的调参（仅在 CHUNK_MODE=semantic 时生效）。阈值=判定「语义低谷」的余弦下限；
# 最小值=低谷处允许切块的最小已累积 token（避免切出碎片）。A/B 定下来的值写这里。
# Tuning for semantic mode (only live when CHUNK_MODE=semantic). Threshold = the cosine
# floor that counts as a semantic valley; min tokens = the least accumulated text a cut
# may happen after (avoids fragmenting). Put the A/B winners here.
CHUNK_SEMANTIC_THRESHOLD=0.80
CHUNK_SEMANTIC_MIN_TOKENS=200

# docling-serve 地址（可选的第二解析后端，需自行部署，例如 infra/ 的
# compose profile `local-docling`）。**留空 = 关闭 docling 后端**：客户端直接抛
# DoclingUnavailable、不去连任何东西，解析按上面的降级规则走内置 pypdf。
# docling-serve address (the optional second parser backend; deploy it yourself, e.g.
# the `local-docling` compose profile in infra/). **Empty = docling backend off**: the
# client raises DoclingUnavailable without connecting anywhere and parsing falls back
# to the built-in pypdf as described above.
DOCLING_URL=
# 客户端超时；**必须大于** DOCLING_DOCUMENT_TIMEOUT —— 服务端先中止文档，客户端更短
# 只会白扔掉一次马上要完成的解析。
# Client timeout; it **must exceed** DOCLING_DOCUMENT_TIMEOUT -- the server aborts the
# document first, so a shorter client timeout just throws away a parse that was about
# to finish.
DOCLING_TIMEOUT=660
# document_timeout 表单字段（服务端默认无期限，会让一篇论文把核占满几十分钟）。
# 实测最坏一篇（7 页公式密集）252s，600 留了 2.4× 余量。
# The document_timeout form field (the server's default is no limit, which lets one
# paper occupy the cores for tens of minutes). The worst paper measured (7 pages, dense
# formulas) took 252s, and 600 leaves 2.4x headroom.
DOCLING_DOCUMENT_TIMEOUT=600
# 瞬时失败（5xx / 超时 / 空 body）重试次数；4xx 与「200 但 errors 非空」不重试。
# Retries for transient failures (5xx / timeout / empty body); 4xx and "200 with a
# non-empty errors field" are not retried.
DOCLING_MAX_RETRIES=1
# 语料是电子版原生 PDF，关掉 OCR（服务端默认是开的）。
# The corpus is born-digital PDF, so OCR is off (the server has it on by default).
DOCLING_OCR=false
DOCLING_TABLE_MODE=accurate
# 公式 LaTeX（**默认关**）：贵（5 页 5.9s → 39.2s，最坏一篇 252s；同一篇 5.9MB 论文
# 带公式整篇导入 ~310s，同一篇走降级侧 pypdf ~52s）。关掉时请求里 do_formula_enrichment=false、
# 也不发 preset，docling 的公式块会以纯文本形式回来。
# 部署需要 $$...$$ 时：设 true + 配 DOCLING_FORMULA_PRESET，且镜像里必须有公式模型
# （v1.35.0-formula 已把 CodeFormulaV2 烤进去；不配 preset 服务端会 404）。
# 开着时若服务端在公式上失败（缺模型/超时），客户端会自动去掉公式重试一次，并把
# formulas=text 记进 degraded_reason —— 不是整篇失败。
# **这个值属于解析产物缓存身份**：改了它，已有产物不会被重放（会真解析一遍）。
# Formula LaTeX (**off by default**): expensive (5 pages 5.9s -> 39.2s, worst paper
# 252s; importing a 5.9MB paper whole with formulas takes ~310s, the same paper on the
# pypdf fallback ~52s). When off, the request carries do_formula_enrichment=false and no
# preset, so docling returns formula blocks as plain text. To deploy $$...$$: set true
# and configure DOCLING_FORMULA_PRESET, and the image must carry the formula model
# (v1.35.0-formula bakes in CodeFormulaV2; without a preset the server 404s). While it is
# on, if the server fails on formulas (missing model/timeout) the client retries once
# without them and records formulas=text in degraded_reason -- not a whole-document
# failure. **This value is part of the parse-artefact cache identity**: change it and
# existing artefacts are not replayed (the document is really parsed again).
DOCLING_FORMULA_ENRICHMENT=false
DOCLING_FORMULA_PRESET=codeformulav2
DOCLING_PAGE_BREAK=<!-- page-break -->
# GET /version 取不到时的兜底版本号（填镜像 tag，写进产物元数据）
# Fallback version when GET /version is unavailable (use the image tag; it is written
# into the artefact metadata).
DOCLING_IMAGE_TAG=paperbox-docling-cpu:v1.35.0-formula

# ══════════════════════════════════════════════════════════════════════
# 部署相关（数据目录 / 容器化时的依赖地址）
# Deployment (data directories / dependency addresses when containerised)
# ══════════════════════════════════════════════════════════════════════
#
# 1) 容器数据目录：这些变量由 infra/docker-compose.yml 读取，**要写在 infra/.env**
#    （docker compose 只读 compose 文件同目录的 .env，不是仓库根这份）。
#    不设则默认落到 infra/data/<service>。服务器上建议给绝对路径：
# 1) Container data directories: these are read by infra/docker-compose.yml, so they
#    **belong in infra/.env** (docker compose only reads the .env next to the compose
#    file, not this one at the repo root). Unset they default to infra/data/<service>;
#    on a server, absolute paths are recommended:
# POSTGRES_DATA_DIR=/srv/paperbox/data/postgres
# OPENSEARCH_DATA_DIR=/srv/paperbox/data/opensearch
# MINIO_DATA_DIR=/srv/paperbox/data/minio
# EMBEDDING_MODELS_DIR=/srv/paperbox/data/embedding-models
# 端口绑定地址（服务器上可设 127.0.0.1，让依赖端口只对本机开放）：
# Port bind address (on a server set 127.0.0.1 so dependency ports stay local):
# PAPERBOX_BIND_IP=127.0.0.1
#
# 2) 应用跑在容器里时，下面五个地址要指向宿主网关（根 docker-compose.yml 已配 extra_hosts），
#    否则容器内的 127.0.0.1 是容器自己。与依赖放同一 docker 网络时改用服务名。
# 2) When the app itself runs in a container, the five addresses below must point at the
#    host gateway (the root docker-compose.yml already sets extra_hosts), otherwise
#    127.0.0.1 inside the container is the container itself. On the same docker network
#    as the dependencies, use the service names instead.
# POSTGRES_DSN=postgresql+psycopg://postgres:<password>@host.docker.internal:5432/paperbox
# OPENSEARCH_URL=http://host.docker.internal:9200
# MINIO_ENDPOINT=host.docker.internal:9000
# EMBEDDING_URL=http://host.docker.internal:8090
# RERANK_URL=http://host.docker.internal:8090
# 同网络写法：postgres:5432 / opensearch:9200 / minio:9000 / embedding:8090
# Same-network form: postgres:5432 / opensearch:9200 / minio:9000 / embedding:8090
